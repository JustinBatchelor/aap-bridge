FROM registry.redhat.io/ubi9/nodejs-20-minimal:latest AS builder
USER 0
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build
FROM registry.redhat.io/ubi9/ubi-minimal:latest
RUN microdnf install -y nginx && microdnf clean all &&     rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*
COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/openshift/nginx.conf /etc/nginx/nginx.conf
USER 1001
EXPOSE 8080
CMD ["nginx", "-e", "/dev/stderr", "-g", "daemon off;"]
